{
    "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
    "runtime.version": "Lua 5.1",
    "completion.requireSeparator": "/",
    "runtime.path": ["?", "?.lua"],
    "workspace.library": ["recoil-lua-library", "types"],
    "workspace.ignoreDir": ["lua/*-template.lua"],
    "diagnostics.globals": ["BAR", "Json", "UnitDefs"],
    "diagnostics.disable": ["exp-in-action"],
    "runtime.special": {
        "VFS.Include": "require",
        "include": "require",
        "shard_include": "require"
    }
}
